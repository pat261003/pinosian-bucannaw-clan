DATABASE_URL=postgresql://postgres:password@localhost:5432/reunion
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
PORT=3001
# Local preview only: unset DATABASE_URL and set LOCAL_DATABASE=true.
LOCAL_DATABASE=false
# For external PostgreSQL requiring TLS. Certificate verification stays enabled.
DATABASE_SSL=false
# Online deployment: use the Neon Connect dialog's PostgreSQL URL for DATABASE_URL.
# Set DATABASE_SSL=true on Render. Neon URLs also enable verified TLS automatically.
# Keep DATABASE_URL on the backend; never use a VITE_ prefix for secrets.
