{
  "name": "reunion-family-tree",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "test": "npm run test -w server",
    "start": "npm run start -w server",
    "test:browser": "node scripts/browser-check.mjs",
    "test:print": "node scripts/print-check.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.9"
  },
  "engines": {
    "node": ">=22"
  }
}
